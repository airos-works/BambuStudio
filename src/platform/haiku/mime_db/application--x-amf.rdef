// The MIME type application/x-amf, shipped in the package's data/mime_db (see tools/haiku/stage-mime-db.sh).
resource(1, "META:TYPE") "application/x-amf";
resource(2, "META:S:DESC") #'MSDC' "AMF model";
resource(3, "META:L:DESC") #'MLDC' "Additive Manufacturing File Format model";
resource(4, "META:PREF_APP") #'MSIG' "application/x-vnd.airos-BambuStudio";
resource(5, "META:EXTENS") message(234) {
	"extensions" = "amf",
	"type" = "application/x-amf"
};
