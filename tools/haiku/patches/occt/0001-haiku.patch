Haiku support for Open CASCADE 7.6.0 (static, no X11, no fontconfig).

- build: a Haiku branch for the libraries a static OCCT asks its users to
  link (threads, dlopen() and the C++ runtime are in libroot and the
  compiler's defaults; sockets in libnetwork); no Xlib.
- OSD: Haiku is a BSD-like Unix for the path syntax; <signal.h> only.
- locale: Haiku has newlocale()/uselocale() (the thread-local "C" locale
  the readers need) but no strtod_l().
- Standard_StackTrace: backtrace() is not in libroot.
- Font_FontMgr: no fontconfig. The fonts are found in the font directories
  of the system and the user (find_directory()), and the default aliases
  name the Noto families Haiku ships.

--- a/adm/cmake/occt_csf.cmake
+++ b/adm/cmake/occt_csf.cmake
@@ -133,6 +133,13 @@
     set (CSF_ThreadLibs  "c")
     set (CSF_OpenGlesLibs "EGL GLESv2")
     set (CSF_androidlog  "log")
+  elseif (HAIKU)
+    # threads, dlopen() and the C++ runtime are in libroot and the compiler's
+    # defaults; no X11, no fontconfig (Font_FontMgr scans the font directories)
+    set (CSF_wsock32     "network")
+    if (USE_OPENGL)
+      set (CSF_OpenGlLibs "GL")
+    endif()
   elseif (UNIX)
     set (CSF_ThreadLibs  "pthread rt stdc++")
     if (USE_XLIB)
